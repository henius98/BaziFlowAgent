TELEGRAM_BOT_TOKEN=                          # Telegram Bot API token from @BotFather
LOG_LEVEL=info                               # Logging level (trace, debug, info, warn, error)

OPENAI_API_KEY=                              # API key for LLM service (OpenAI, Gemini, etc.)
OPENAI_API_BASE=https://api.openai.com/v1    # Base URL for LLM API
LLM_MODEL_NAME=gemini-3.1-pro-high           # Model name for analysis and chat

BASE_URL=http://localhost:8080               # Public base URL for Bazi chart links
DATABASE_URL=sqlite://baziflow_agent.db                 # SQLite database connection URL

USER_CONTEXTS_EXPIRATION_MINUTES=30          # How long to keep history in memory (mins)
MAX_CONTEXT_MESSAGES=10                      # Max recent messages per user in context

BAZI_JOB_CRON="0 0 14 * * *"                 # Cron: Daily Bazi fortune tasks
CONTEXT_CLEANUP_CRON="0 */5 * * * *"         # Cron: Expired context cleanup
LOG_CLEANUP_CRON="0 0 3 * * *"               # Cron: Database log maintenance

LOG_RETENTION_DAYS=30                        # Days to retain request logs in DB