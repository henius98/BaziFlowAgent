TELEGRAM_BOT_TOKEN=                             # Telegram Bot API token from @BotFather
LOG_LEVEL=info                                  # Logging level (trace, debug, info, warn, error)
APP_TIMEZONE=Asia/Singapore                     # Application Timezone (e.g., UTC, Asia/Singapore)

LLM_API_KEY=                                    # API key for LLM service (OpenAI, Gemini, etc.)
LLM_API_BASE=https://api.openai.com/v1          # Base URL for LLM API
LLM_TIMEOUT_SECONDS=60                            # Timeout for LLM requests in seconds
LLM_MODEL_NAME=gemini-3.1-pro-high              # Model name for analysis and chat

BASE_URL=http://localhost:8080                  # Public base URL for Bazi chart links
CORS_ALLOWED_ORIGIN=https://henius98.github.io  # Allowed origins for CORS (e.g. *, http://localhost:3000, or multiple comma-separated)
DATABASE_URL=sqlite://baziflow_agent.db         # SQLite database connection URL
CHAT_CACHE_DATABASE_URL=sqlite://baziflow_chat_cache.db # SQLite chat-history cache database URL
CHAT_CACHE_MAX_MESSAGES=40                    # Per-user cached turns; defaults to 4 × MAX_CONTEXT_MESSAGES

USER_CONTEXTS_EXPIRATION_MINUTES=30             # How long to keep history in memory (mins)
MAX_CONTEXT_MESSAGES=10                         # Max recent messages per user in context

CONTEXT_CLEANUP_CRON="0 */5 * * * *"            # Cron: Expired context cleanup
LOG_CLEANUP_CRON="0 0 3 * * *"                  # Cron: Database log maintenance

LOG_RETENTION_DAYS=30                           # Days to retain request logs in DB

# Optional: Cloudflare R2 Storage (for Bazi HTML charts)
R2_ACCOUNT_ID=                                  # Cloudflare Account ID
R2_ACCESS_KEY_ID=                               # R2 Access Key ID
R2_SECRET_ACCESS_KEY=                           # R2 Secret Access Key
R2_BUCKET_NAME=                                 # R2 Bucket Name

# Network/resource budgets. Production: terminate WSS at a trusted reverse proxy.
HTTP_BIND_ADDRESS=127.0.0.1:8080
WS_MAX_CONNECTIONS=256
API_MAX_REQUESTS=64
APP_MAX_WORK=16
APP_MAX_CONTEXTS=256
API_MAX_MESSAGE_BYTES=16384
WS_QUEUE_CAPACITY=32
API_REQUESTS_PER_MINUTE=120
WS_IDLE_SECONDS=60
WS_SEND_SECONDS=5
APP_WORK_SECONDS=180
SHUTDOWN_SECONDS=30
