meta {
  name: Get local chart
  type: http
  seq: 1
}

get {
  url: {{base_url}}/charts/{{chart_token}}
  body: none
  auth: none
}

docs {
  Set the secret chart_token to the 72 hexadecimal characters from a returned /charts/<token> URL.
  No Bearer authentication: the URL token grants access. Stateless AES-256-GCM capability link.
  Returns HTML, or 404 for missing/invalid tokens or files.
  For an R2 chart_url, open the full presigned URL separately; it is not this application route.
}
