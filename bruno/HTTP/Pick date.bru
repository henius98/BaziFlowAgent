meta {
  name: Pick date
  type: http
  seq: 3
}

post {
  url: {{base_url}}/api/v1/pick-date
  body: json
  auth: inherit
}

headers {
  Content-Type: application/json
  Accept: application/json
}

body:json {
  {
    "start_date": "{{start_date}}",
    "end_date": "{{end_date}}",
    "activity": "{{activity}}",
    "reasoning_effort": "high"
  }
}

docs {
  Requires an existing Bazi profile. Dates use YYYY-MM-DD; activity must not be blank.
  reasoning_effort is optional: none, minimal, low, medium, high, or xhigh.
}
