meta {
  name: Chat
  type: http
  seq: 7
}

post {
  url: {{base_url}}/api/v1/chat
  body: json
  auth: inherit
}

headers {
  Content-Type: application/json
  Accept: application/json
}

body:json {
  {
    "message": "{{message}}",
    "reasoning_effort": "high"
  }
}

docs {
  Requires an existing Bazi profile. Sends a follow-up and persists conversation history.
  reasoning_effort is optional: none, minimal, low, medium, high, or xhigh.
}
