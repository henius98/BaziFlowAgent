// Project-local debug tasks
//
// For more documentation on how to configure debug tasks,
// see: https://zed.dev/docs/debugger
[
  {
    "label": "Debug BaziFlow",
    "adapter": "CodeLLDB",
    "request": "launch",
    "program": "$ZED_WORKTREE_ROOT/target/debug/baziflow-agent",
    "cwd": "$ZED_WORKTREE_ROOT",
    "sourceLanguages": ["rust"],
    "env": {
      "LD_LIBRARY_PATH": "",
      "LD_PRELOAD": "",
      "LOG_LEVEL": "debug",
      "RUST_BACKTRACE": "1"
    },
    "build": {
      "command": "cargo",
      "args": ["build", "--bin=baziflow-agent", "--package=baziflow-agent"],
      "env": {
        "LD_LIBRARY_PATH": "",
        "LD_PRELOAD": ""
      }
    },
    "args": []
  },
  {
    "label": "Debug BaziFlow Library Tests",
    "adapter": "CodeLLDB",
    "cwd": "$ZED_WORKTREE_ROOT",
    "sourceLanguages": ["rust"],
    "env": {
      "LD_LIBRARY_PATH": "",
      "LD_PRELOAD": "",
      "LOG_LEVEL": "debug",
      "RUST_BACKTRACE": "1"
    },
    "build": {
      "command": "cargo",
      "args": ["test", "--no-run", "--lib", "--package=baziflow-agent"],
      "env": {
        "LD_LIBRARY_PATH": "",
        "LD_PRELOAD": ""
      }
    },
    "args": ["--nocapture"]
  }
]
